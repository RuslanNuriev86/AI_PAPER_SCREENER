# Copy to .env (git-ignored). Loaded by systemd via EnvironmentFile= and by `make`.
#
# --- local environment requirements (see DESIGN.md §16) ---
# Both of these are required on hosts where uv's defaults are read-only.
# uv reads UV_CACHE_DIR from the environment; uv.toml already sets cache-dir, so this is
# belt-and-braces. UV_PYTHON_INSTALL_DIR CANNOT go in uv.toml (unknown field in uv 0.8.16)
# so it must be set here for systemd and by `make` for development.
UV_CACHE_DIR=/home/projects/AI_PAPER_SCREENER/.uv-cache
UV_PYTHON_INSTALL_DIR=/home/projects/AI_PAPER_SCREENER/.uv-python

# --- secrets ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- LLM provider: DeepSeek (https://api-docs.deepseek.com) ---
# The adapter speaks OpenAI-shaped chat-completions, which DeepSeek serves at this root.
# The Anthropic-shaped endpoint would be https://api.deepseek.com/anthropic instead.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY / LLM_API_KEY are also accepted as aliases for a non-DeepSeek deployment.
# optional
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
CONTACT_EMAIL=you@example.com
HEARTBEAT_URL=

# --- runtime ---
SCREENER_DB=./screener.db
SCREENER_MODE=live          # live | dry
SCREENER_LLM_FAST=deepseek-flash
SCREENER_LLM_DEEP=deepseek-flash
# Thinking mode is ON by default at the API and IGNORES temperature, which would make the
# rubric non-repeatable. Leave this false unless you want reasoning traces and accept that.
SCREENER_LLM_THINKING=false
SCREENER_BUDGET_USD=2.0

# --- host workaround: malformed NO_PROXY ---
# httpx parses every NO_PROXY entry when building a client, so a bracketed IPv6 literal
# ("[::1]") raises InvalidURL and NO HTTP call works anywhere in the process. If
# `screener doctor` reports "httpx cannot construct a client", uncomment the line below
# (note the unbracketed form) or fix the host's NO_PROXY.
# NO_PROXY=localhost,127.0.0.1,::1
